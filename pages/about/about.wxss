.about-page {
  padding: 30rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.about-card {
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 10rpx 40rpx rgba(24, 41, 35, 0.055);
}

.about-title {
  display: block;
  margin-bottom: 20rpx;
  font-size: 31rpx;
  font-weight: 650;
}

.paragraph {
  display: block;
  color: #66716c;
  font-size: 26rpx;
  line-height: 1.8;
}

.item {
  display: flex;
  align-items: flex-start;
  margin: 20rpx 0;
  color: #66716c;
  font-size: 25rpx;
  line-height: 1.65;
}

.number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  margin: 3rpx 18rpx 0 0;
  border-radius: 50%;
  background: #e5f6ed;
  color: #0b9d61;
  font-size: 21rpx;
  font-weight: 600;
}

.privacy-card {
  border: 2rpx solid #e1f1e9;
}

.footer {
  display: block;
  padding: 24rpx 0;
  color: #9aa19e;
  font-size: 22rpx;
  text-align: center;
}
